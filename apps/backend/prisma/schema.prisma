generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/farm.db"
}

model WorkOrder {
  id        String   @id @default(uuid())
  goal      String
  context   String   @default("{}")
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks     Task[]
  artifacts Artifact[]
  decisions Decision[]
  events    EventLog[]
}

model Task {
  id          String   @id @default(uuid())
  workOrderId String
  title       String
  description String   @default("")
  status      String   @default("NEW")
  ownerRole   String?
  deps        String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workOrder WorkOrder  @relation(fields: [workOrderId], references: [id])
  artifacts Artifact[]

  @@index([workOrderId])
  @@index([status])
}

model Artifact {
  id            String   @id @default(uuid())
  type          String
  content       String
  createdByRole String
  linkedTaskId  String?
  workOrderId   String
  version       Int      @default(1)
  canonical     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  task      Task?     @relation(fields: [linkedTaskId], references: [id])

  @@index([workOrderId])
  @@index([workOrderId, type])
  @@index([linkedTaskId])
}

model Decision {
  id           String   @id @default(uuid())
  summary      String
  rationale    String   @default("")
  role         String
  linkedTaskId String?
  workOrderId  String
  createdAt    DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId])
}

model EventLog {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  role          String?
  action        String
  payload       String   @default("{}")
  correlationId String?
  workOrderId   String?

  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId])
  @@index([action])
  @@index([timestamp])
}

model AgentSession {
  id              String   @id @default(uuid())
  agentPresetId   String
  roleId          String
  workOrderId     String?
  taskId          String?
  status          String   @default("spawning")
  pid             Int?
  workingDirectory String?
  agentSessionId  String?
  lastHeartbeat   DateTime?
  spawnedAt       DateTime @default(now())
  completedAt     DateTime?

  mail AgentMail[] @relation("recipient")
  sentMail AgentMail[] @relation("sender")

  @@index([status])
  @@index([roleId])
  @@index([workOrderId])
}

model AgentMail {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  subject   String
  body      String   @default("")
  sentAt    DateTime @default(now())
  readAt    DateTime?

  sender    AgentSession @relation("sender", fields: [fromId], references: [id])
  recipient AgentSession @relation("recipient", fields: [toId], references: [id])

  @@index([toId])
  @@index([fromId])
}
