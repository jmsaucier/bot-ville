{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.0.2",
    "@prisma/client": "^6.9.0",
    "@bot-ville/core": "workspace:*",
    "@bot-ville/shared": "workspace:*",
    "fastify": "^5.3.3"
  },
  "devDependencies": {
    "@bot-ville/eslint-config": "workspace:*",
    "@bot-ville/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.1",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "5.9.2",
    "vitest": "^3.2.1"
  }
}
