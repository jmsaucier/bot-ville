{
  "name": "desktop",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "tsc -p tsconfig.main.json && vite build --config src/renderer/vite.config.ts",
    "start": "electron dist/main/main.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc -p tsconfig.main.json --noEmit",
    "package": "electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@bot-ville/shared": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.6.1"
  },
  "devDependencies": {
    "@bot-ville/eslint-config": "workspace:*",
    "@bot-ville/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "tsx": "^4.19.4",
    "typescript": "5.9.2",
    "vite": "^6.3.5"
  }
}
